# Salin file ini menjadi `.env` di root repo (atau di folder `backend/`).
# Nilai di bawah adalah default pengembangan.

# --- Aplikasi ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Default: SQLite lokal di backend/construction.db
# Untuk Postgres (docker compose):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_db

# --- CORS (dipisah koma) ---
CORS_ORIGINS=http://localhost:3000

# --- Lapisan LLM (Fase 2+) ---
# Provider: openai (API) | ollama (lokal)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
# Base URL provider OpenAI-compatible. Bisa diarahkan ke DeepSeek/Groq/OpenRouter.
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Untuk mode lokal: LLM_PROVIDER=ollama + OLLAMA_BASE_URL
OLLAMA_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=

# --- Fase 4: Auth & multi-tenant ---
# Set true setelah user pertama dibuat.
AUTH_ENABLED=false
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Fase 4: Background jobs ---
# Set true untuk menjalankan analisis async via worker.
JOBS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
