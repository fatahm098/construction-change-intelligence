# Salin file ini menjadi `.env` di root repo (atau di folder `backend/`).
# Nilai di bawah adalah default pengembangan.

# --- Aplikasi ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Default: SQLite lokal di backend/construction.db
# Untuk Postgres (docker compose):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_db

# --- CORS (dipisah koma) ---
CORS_ORIGINS=http://localhost:3000

# --- Lapisan LLM (Fase 2+) ---
# Provider: deepseek (default) | openai (API) | ollama (lokal) | local (offline)
# `local` = embedding hashing + jawaban ekstraktif, untuk dev/demo tanpa biaya API.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
# DeepSeek belum punya endpoint embeddings; RAG memakai hashing lokal.
LLM_EMBEDDING_MODEL=deepseek-embedding
# Base URL provider OpenAI-compatible (default DeepSeek).
LLM_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
# Fallback key untuk provider openai / endpoint OpenAI-compatible lain.
OPENAI_API_KEY=
# Untuk mode lokal: LLM_PROVIDER=ollama + OLLAMA_BASE_URL
OLLAMA_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=

# --- Fase 4: Auth & multi-tenant ---
# Set true setelah user pertama dibuat.
AUTH_ENABLED=false
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Fase 4: Background jobs ---
# Set true untuk menjalankan analisis async via worker.
JOBS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# --- Observability / logging ---
# Level log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = log JSON terstruktur (produksi); false = teks biasa (dev).
LOG_JSON=true

# --- Pengaturan runtime (API key LLM) ---
# Kunci enkripsi API key yang disimpan di DB. Kosong = turunkan dari JWT_SECRET
# (cukup untuk dev). Untuk produksi isi string acak panjang, mis. hasil `openssl rand -hex 32`.
SETTINGS_ENCRYPTION_KEY=

# --- Produksi (docker-compose.prod.yml) ---
# Kredensial Postgres untuk container `db`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=construction_db
# URL backend yang dapat diakses BROWSER (di-inline saat build frontend).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Aktifkan UI login di frontend (samakan dengan AUTH_ENABLED backend).
NEXT_PUBLIC_AUTH_ENABLED=false
