# Salin file ini menjadi `.env` di root repo (atau di folder `backend/`).
# Nilai di bawah adalah default pengembangan.

# --- Aplikasi ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Default: SQLite lokal di backend/construction.db
# Untuk Postgres (docker compose):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_db

# --- CORS (dipisah koma) ---
CORS_ORIGINS=http://localhost:3000

# --- Lapisan LLM (Fase 2+) ---
# Provider: deepseek (default) | openai (API) | ollama (lokal) | local (offline)
# `local` = embedding hashing + jawaban ekstraktif, untuk dev/demo tanpa biaya API.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
# DeepSeek belum punya endpoint embeddings; RAG memakai hashing lokal.
LLM_EMBEDDING_MODEL=deepseek-embedding
# Base URL provider OpenAI-compatible (default DeepSeek).
LLM_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
# Fallback key untuk provider openai / endpoint OpenAI-compatible lain.
OPENAI_API_KEY=
# Untuk mode lokal: LLM_PROVIDER=ollama + OLLAMA_BASE_URL
OLLAMA_BASE_URL=http://localhost:11434
# ANTHROPIC_API_KEY=

# --- Embedding RAG (terpisah dari LLM chat) ---
# hash    = offline, kemiripan leksikal, tanpa biaya (default)
# openai  = endpoint /embeddings OpenAI-compatible (semantik, butuh API key)
# Setelah mengganti provider, jalankan POST /api/doc-qa/reindex karena
# dimensi vektor berubah (hash 512 vs text-embedding-3-small 1536).
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Kosong = fallback ke OPENAI_API_KEY.
EMBEDDING_API_KEY=

# --- Fase 4: Auth & multi-tenant ---
# false = semua API terbuka (dev/demo). true = seluruh API wajib Bearer JWT,
# kecuali /health, /health/ready, /api/auth/login, /api/auth/register, /docs,
# /redoc, /openapi.json, dan /static/*.
# PRODUKSI WAJIB true (docker-compose.prod.yml memaksa nilainya true).
AUTH_ENABLED=false
# Kunci tanda tangan JWT. WAJIB diganti di produksi; jangan pakai nilai dev ini.
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Fase 4: Background jobs ---
# Set true untuk menjalankan analisis async via worker.
JOBS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# --- Observability / logging ---
# Level log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = log JSON terstruktur (produksi); false = teks biasa (dev).
LOG_JSON=true

# --- Pengaturan runtime (API key LLM) ---
# Kunci enkripsi API key LLM yang disimpan di DB. WAJIB diisi di produksi
# (docker-compose.prod.yml menolak nilai kosong). Jangan pakai nilai contoh.
# Kosong di dev = fallback turunan JWT_SECRET (jangan dipakai di produksi).
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
SETTINGS_ENCRYPTION_KEY=

# --- Produksi (docker-compose.prod.yml) ---
# Kredensial Postgres untuk container `db`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=construction_db
# URL backend yang dapat diakses BROWSER (di-inline saat build frontend).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Aktifkan UI login di frontend (samakan dengan AUTH_ENABLED backend).
NEXT_PUBLIC_AUTH_ENABLED=false
