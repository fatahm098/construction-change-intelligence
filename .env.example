# Salin file ini menjadi `.env` di root repo (atau di folder `backend/`).
# Nilai di bawah adalah default pengembangan.

# --- Aplikasi ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Default: SQLite lokal di backend/construction.db
# Untuk Postgres (docker compose):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_db
# DATABASE_URL=

# --- CORS (dipisah koma) ---
CORS_ORIGINS=http://localhost:3000

# --- Lapisan LLM (Fase 2+) ---
# Provider: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
